# --- Claude (the reasoning layer) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=high

# --- Alpaca (market data + account snapshot) ---
# Create keys at https://app.alpaca.markets/ -> Home -> API Keys.
# Paper keys work fine: this bot only READS from Alpaca, it never places orders.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# "iex" is the free feed. "sip" needs a paid data subscription.
ALPACA_DATA_FEED=iex
# Trading base URL, used only for /v2/clock and /v2/account (read-only).
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets

# --- Risk policy (all enforced in code, not just in the prompt) ---
MAX_RISK_PCT=0.02
MAX_POSITION_PCT=0.25
STOP_ATR_MULT=1.5
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
ALLOW_CONTRARIAN_OVERRIDE=true
MIN_CONFIDENCE=MEDIUM
